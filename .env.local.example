# Скопируйте этот файл в .env.local и заполните значениями из Supabase
# (Project Settings → API) на этапе 2. .env.local не коммитится в git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret/service_role key — server-only, no NEXT_PUBLIC_ prefix.
# Needed for app/api/employees and app/api/roles (managing employees & access).
# Also add this one in Vercel's project settings (Environment Variables),
# not just locally — it's not committed to git.
SUPABASE_SERVICE_ROLE_KEY=
